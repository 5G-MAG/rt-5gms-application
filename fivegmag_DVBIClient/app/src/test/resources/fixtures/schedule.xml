<TVAMain xmlns="urn:tva:metadata:2024" xmlns:mpeg7="urn:tva:mpeg7:2008" xml:lang="en">
  <ProgramDescription>
    <ProgramInformationTable>
      <ProgramInformation programId="crid://example.com/prog/1">
        <BasicDescription>
          <Title type="main">Morning News</Title>
          <Title type="secondary">Episode 4</Title>
          <Synopsis length="medium">The news.</Synopsis>
          <Synopsis length="long">The news of the morning, with the weather.</Synopsis>
        </BasicDescription>
      </ProgramInformation>
      <ProgramInformation programId="crid://example.com/prog/2">
        <BasicDescription>
          <Title>Documentary</Title>
          <Genre href="urn:tva:metadata:cs:ContentCS:2011:3.1.3"/>
        </BasicDescription>
      </ProgramInformation>
    </ProgramInformationTable>
    <ProgramLocationTable>
      <Schedule serviceIDRef="tag:sample,2024:service:a" start="2026-10-02T12:00:00Z" end="2026-10-03T00:00:00Z">
        <ScheduleEvent>
          <Program crid="crid://example.com/prog/2"/>
          <PublishedStartTime>2026-10-02T13:00:00Z</PublishedStartTime>
          <PublishedDuration>PT1H30M</PublishedDuration>
        </ScheduleEvent>
        <ScheduleEvent>
          <Program crid="crid://example.com/prog/1"/>
          <PublishedStartTime>2026-10-02T12:00:00Z</PublishedStartTime>
          <PublishedDuration>P0DT1H</PublishedDuration>
        </ScheduleEvent>
      </Schedule>
    </ProgramLocationTable>
  </ProgramDescription>
</TVAMain>
